{
  "name": "entropic-bond",
  "type": "module",
  "version": "1.60.0",
  "description": "Tidy up your messy components",
  "main": "./lib/entropic-bond.umd.cjs",
  "module": "./lib/entropic-bond.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/entropic-bond.js",
      "require": "./lib/entropic-bond.umd.cjs"
    }
  },
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest",
    "provenance": true,
    "branches": [
      "master"
    ]
  },
  "release": {
    "plugins": [
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  },
  "scripts": {
    "test": "vitest",
    "build": "vite build && tsc -p tsconfig-build.json --emitDeclarationOnly",
    "watch": "vite build --watch",
    "docs": "typedoc --options typedoc.json",
    "postinstall": "node scripts/setup-typedoc-ts6.cjs",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/entropic-bond/entropic-bond.git"
  },
  "keywords": [
    "persistence",
    "reactive",
    "component",
    "observable"
  ],
  "author": "Josep Seto",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/entropic-bond/entropic-bond/issues"
  },
  "homepage": "https://github.com/entropic-bond/entropic-bond#readme",
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@type-challenges/utils": "^0.1.1",
    "@types/node": "^26.4.1",
    "@types/uuid": "^10.0.0",
    "semantic-release": "^25.0.9",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^7.0.x",
    "typescript6": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "uuid": "^14.0.2"
  }
}
